<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>IronFit Gym | Ghaziabad</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #080808;
            color: white;
        }

        /* Navigation */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 8%;
            background: #050505;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 26px;
            font-weight: bold;
            color: #e60000;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
        }

        nav a:hover {
            color: #e60000;
        }

        /* Hero */
        .hero {
            min-height: 90vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 30px;
            background: linear-gradient(
                rgba(0,0,0,0.7),
                rgba(0,0,0,0.9)
            );
        }

        .hero h1 {
            font-size: 60px;
            color: #e60000;
            margin-bottom: 15px;
        }

        .hero h2 {
            font-size: 30px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 18px;
            color: #ccc;
            margin-bottom: 25px;
        }

        .btn {
            display: inline-block;
            background: #e60000;
            color: white;
            padding: 14px 28px;
            margin: 8px;
            border-radius: 5px;
            text-decoration: none;
            font-weight: bold;
        }

        .btn:hover {
            background: #ff2020;
        }

        /* Sections */
        section {
            padding: 70px 8%;
            text-align: center;
        }

        section h2 {
            font-size: 36px;
            margin-bottom: 20px;
            color: #e60000;
        }

        section p {
            color: #ccc;
            line-height: 1.7;
        }

        /* Services */
        .cards {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 35px;
        }

        .card {
            background: #151515;
            padding: 30px;
            width: 250px;
            border-radius: 10px;
            border: 1px solid #333;
        }

        .card h3 {
            margin-bottom: 10px;
            color: white;
        }

        .card p {
            font-size: 14px;
        }

        /* Membership */
        .price-box {
            max-width: 350px;
            margin: 30px auto;
            padding: 40px;
            background: #151515;
            border: 2px solid #e60000;
            border-radius: 12px;
        }

        .price {
            font-size: 48px;
            color: #e60000;
            font-weight: bold;
            margin: 15px 0;
        }

        /* Contact */
        .contact {
            background: #111;
        }

        .phone {
            display: inline-block;
            margin-top: 20px;
            font-size: 24px;
            color: white;
            text-decoration: none;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 25px;
            background: #050505;
            color: #888;
        }

        @media (max-width: 600px) {
            .hero h1 {
                font-size: 42px;
            }

            .hero h2 {
                font-size: 22px;
            }

            nav {
                padding: 15px 5%;
            }

            nav a {
                margin-left: 8px;
                font-size: 13px;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav>
        <div class="logo">IRONFIT</div>

        <div>
            <a href="#about">About</a>
            <a href="#services">Services</a>
            <a href="#membership">Membership</a>
            <a href="#contact">Contact</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div>
            <h1>IRONFIT GYM</h1>

            <h2>Transform Your Body. Build Your Strength.</h2>

            <p>
                Your fitness journey starts here.
                Train hard. Stay strong. Become better.
            </p>

            <a href="#membership" class="btn">Join Now</a>

            <a href="tel:9536355920" class="btn">Call Us</a>
        </div>
    </section>

    <!-- About -->
    <section id="about">
        <h2>About IronFit</h2>

        <p>
            IronFit Gym is a dedicated fitness space in Ghaziabad
            for people who want to become stronger, healthier and fitter.
            Whether you are starting your fitness journey or already training,
            we are here to help you stay consistent.
        </p>
    </section>

    <!-- Services -->
    <section id="services">
        <h2>Our Services</h2>

        <div class="cards">

            <div class="card">
                <h3>🏋️ Strength Training</h3>
                <p>
                    Build strength with proper gym equipment
                    and consistent training.
                </p>
            </div>

            <div class="card">
                <h3>🏃 Cardio</h3>
                <p>
                    Improve your fitness and endurance
                    with cardio workouts.
                </p>
            </div>

            <div class="card">
                <h3>💪 Fitness Training</h3>
                <p>
                    Work on your overall fitness with
                    structured workouts.
                </p>
            </div>

        </div>
    </section>

    <!-- Membership -->
    <section id="membership">
        <h2>Membership Plan</h2>

        <div class="price-box">

            <h3>Monthly Membership</h3>

            <div class="price">₹699</div>

            <p>
                Full gym access<br>
                Fitness training<br>
                Friendly environment
            </p>

            <a href="tel:9536355920" class="btn">
                Join Now
            </a>

        </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="contact">

        <h2>Contact Us</h2>

        <p>📍 Ghaziabad, Uttar Pradesh</p>

        <a href="tel:9536355920" class="phone">
            📞 9536355920
        </a>

        <br>

        <a href="tel:9536355920" class="btn">
            Call Now
        </a>

    </section>

    <!-- Footer -->
    <footer>
        © 2026 IronFit Gym. All Rights Reserved.
    </footer>

</body>
</html>
